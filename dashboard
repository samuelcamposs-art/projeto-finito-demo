<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Projeto Finito: painel</title>
  <style>
    :root { --verde:#6EA67F; --roxo:#9484B3; --azul:#BEDBE9; --cinza:#EAE6E3; --texto:#3B3A40; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui,-apple-system,"Segoe UI",sans-serif; background:var(--cinza); color:var(--texto); }
    .banner { background:var(--roxo); color:#fff; text-align:center; padding:8px; font-weight:700; font-size:.85rem; letter-spacing:.04em; }
    header.topo { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 24px; background:#fff; box-shadow:0 1px 4px rgba(0,0,0,.08); flex-wrap:wrap; }
    header.topo img { height:56px; }
    .usuario { text-align:right; font-size:.9rem; }
    .usuario strong { color:var(--roxo); }
    main { max-width:1100px; margin:20px auto; padding:0 16px 40px; }
    .filtros { display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; background:#fff; padding:14px; border-radius:12px; margin-bottom:16px; border-top:4px solid var(--azul); }
    .filtros label { font-size:.85rem; display:flex; flex-direction:column; gap:4px; }
    select, input { padding:7px; border:1px solid #cfc9c5; border-radius:6px; font-size:.9rem; background:#fff; }
    .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:16px; }
    .kpi { background:#fff; padding:14px; border-radius:12px; border-left:5px solid var(--verde); }
    .kpi b { display:block; font-size:1.5rem; color:var(--roxo); }
    .kpi span { font-size:.8rem; }
    .grade { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:16px; }
    .card { background:#fff; padding:16px; border-radius:12px; box-shadow:0 2px 8px rgba(59,58,64,.06); }
    .card h2 { font-size:1rem; margin:0 0 10px; color:var(--roxo); }
    table { width:100%; border-collapse:collapse; font-size:.85rem; }
    td, th { padding:6px; border-bottom:1px solid #eee; text-align:left; }
    th { color:var(--verde); }
    .vazio { color:#888; font-size:.85rem; }
    .acoes { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin:0 0 16px; font-size:.9rem; }
    button { padding:8px 14px; border:0; border-radius:6px; background:var(--verde); color:#fff; font-weight:600; cursor:pointer; }
    button.sec { background:transparent; color:var(--roxo); text-decoration:underline; font-weight:500; padding:0; }
    .msg { color:#7a2030; font-size:.9rem; }
    #cabecalho-impressao { display:none; }
    @media print {
      body { background:#fff; }
      .banner, header.topo, .nao-imprimir { display:none !important; }
      #cabecalho-impressao { display:block; margin-bottom:12px; font-size:12px; }
      .oculto-impressao { display:none !important; }
      .grade { display:block; }
      .card { box-shadow:none; break-inside:avoid; margin-bottom:12px; }
    }
  </style>
</head>
<body>
  <div class="banner">DEMONSTRAÇÃO: dados fictícios</div>

  <header class="topo">
    <img src="logo.png" alt="Projeto Finito">
    <div class="usuario">
      <div>Olá, <strong id="nome"></strong></div>
      <div id="perfil"></div>
      <button class="sec" id="sair">Sair</button>
    </div>
  </header>

  <main>
    <div id="cabecalho-impressao"></div>

    <form class="filtros nao-imprimir" onsubmit="return false">
      <label>De <input type="date" id="f-de"></label>
      <label>Até <input type="date" id="f-ate"></label>
      <label id="lbl-prest" hidden>Prestador <select id="f-prest"></select></label>
      <label>Situação do paciente <select id="f-sit"></select></label>
      <button type="button" id="aplicar">Aplicar</button>
    </form>

    <div class="acoes nao-imprimir">
      <span>Incluir no PDF:</span>
      <div id="checks"></div>
      <button type="button" id="pdf">Exportar PDF</button>
    </div>

    <p class="msg" id="erro"></p>
    <div id="conteudo"></div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
  <script>
    // Chave pública (publishable). O acesso aos dados é controlado pelo RLS do banco, não pelo front-end.
    const sb = supabase.createClient('https://lkfmaienspuiufqhmmag.supabase.co', 'sb_publishable_oJp9-Q0gxwe7o5izcO7BGQ_1_7zmS3z');

    const $ = (id) => document.getElementById(id);
    const HOJE = new Date().toISOString().slice(0, 10);
    const PAPEL = { master: 'Master', prestador: 'Profissional' };
    const STATUS = { em_espera: 'Em espera', ativo: 'Ativo', interrompido: 'Interrompido', falecido: 'Falecido' };
    const SEXO = { feminino: 'Feminino', masculino: 'Masculino', nao_informado: 'Não informado' };

    let eu = null, cidade = null;
    let usuarios = new Map(), pacientes = [], sens = new Map(), com = [], visitas = [], designacoes = [], agenda = [];

    // ---------- utilidades ----------
    const dias = (a, b) => Math.round((new Date(b) - new Date(a)) / 86400000);
    const anos = (nasc) => Math.floor(dias(nasc, HOJE) / 365.25);
    const fmt = (iso) => (iso ? iso.split('-').reverse().join('/') : '—');
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const kpi = (valor, rotulo) => `<div class="kpi"><b>${esc(valor)}</b><span>${esc(rotulo)}</span></div>`;
    const sec = (id, titulo, corpo) => `<section class="card" data-secao="${id}" data-titulo="${esc(titulo)}"><h2>${esc(titulo)}</h2>${corpo}</section>`;

    function tabela(cabecalhos, linhas) {
      if (!linhas.length) return '<p class="vazio">Sem dados no filtro atual.</p>';
      return `<table><tr>${cabecalhos.map((h) => `<th>${esc(h)}</th>`).join('')}</tr>` +
        linhas.map((r) => `<tr>${r.map((c) => `<td>${esc(c)}</td>`).join('')}</tr>`).join('') + '</table>';
    }

    function contar(lista, fn) {
      const m = new Map();
      for (const x of lista) { const k = fn(x); m.set(k, (m.get(k) || 0) + 1); }
      return [...m.entries()].sort((a, b) => b[1] - a[1]);
    }

    // Faixas etárias adaptativas: pacientes divididos em até 5 grupos de tamanho parecido,
    // com o intervalo real de idades de cada grupo (sem faixas vazias).
    function faixasDe(idades) {
      if (!idades.length) return [];
      const s = [...idades].sort((a, b) => a - b);
      const k = Math.min(5, new Set(s).size);
      const tam = Math.ceil(s.length / k);
      const out = [];
      for (let i = 0; i < s.length; i += tam) {
        const g = s.slice(i, i + tam);
        const a = g[0], b = g[g.length - 1];
        out.push([a === b ? `${a} anos` : `${a} a ${b} anos`, g.length]);
      }
      return out;
    }

    // ---------- carregamento (o banco já filtra o que cada conta pode ver) ----------
    async function carregar() {
      const [p, s, c, v, d, us, ag, ci] = await Promise.all([
        sb.from('pacientes').select('id,numero,nome,sexo,bairro,esf,status,data_inicio,data_interrupcao,data_obito,dados_incompletos,excluido_em'),
        sb.from('pacientes_sensiveis').select('paciente_id,data_nascimento'),
        sb.from('paciente_comorbidades').select('paciente_id,comorbidades(nome)'),
        sb.from('visitas').select('id,paciente_id,prestador_id,data_visita,situacao,excluido_em'),
        sb.from('designacoes').select('paciente_id,usuario_id,ativa'),
        sb.from('usuarios').select('id,nome,papel,area,ativo'),
        sb.from('agenda_designada').select('id,paciente_id,data_visita,situacao,prestador_id'),
        sb.from('cidades').select('nome,dias_sem_visita_alerta').maybeSingle(),
      ]);
      const erros = [p, s, c, v, d, us, ag, ci].filter((r) => r.error);
      if (erros.length) $('erro').textContent = 'Não foi possível carregar alguns dados. Atualize a página.';
      pacientes = (p.data || []).filter((x) => !x.excluido_em);
      sens = new Map((s.data || []).map((x) => [x.paciente_id, x]));
      com = c.data || [];
      visitas = (v.data || []).filter((x) => !x.excluido_em);
      designacoes = (d.data || []).filter((x) => x.ativa);
      usuarios = new Map((us.data || []).map((x) => [x.id, x]));
      agenda = ag.data || [];
      cidade = ci.data || null;
    }

    // ---------- seções do master ----------
    function htmlMaster(f, pac, vis) {
      const ids = new Set(pac.map((p) => p.id));
      const conc = vis.filter((v) => v.situacao === 'concluida');
      const agd = vis.filter((v) => v.situacao === 'agendada');
      const atendidos = new Set(conc.map((v) => v.paciente_id)).size;
      const cont = (s) => pac.filter((p) => p.status === s).length;
      const tempos = pac.filter((p) => p.data_inicio).map((p) => dias(p.data_inicio, p.data_obito || p.data_interrupcao || HOJE) / 30.44);
      const tmedio = tempos.length ? (tempos.reduce((a, b) => a + b, 0) / tempos.length).toFixed(1) : '0';
      const media = atendidos ? (conc.length / atendidos).toFixed(1) : '0';

      const cards = `<div class="cards" data-secao="resumo" data-titulo="Resumo">` +
        kpi(pac.length, 'Pacientes') + kpi(cont('ativo'), 'Ativos') + kpi(cont('em_espera'), 'Em espera') +
        kpi(cont('interrompido'), 'Interrompidos') + kpi(cont('falecido'), 'Falecidos') +
        kpi(conc.length, 'Visitas concluídas') + kpi(agd.length, 'Visitas agendadas') +
        kpi(media, 'Visitas por paciente atendido') + kpi(tmedio, 'Tempo médio (meses)') + '</div>';

      // faixa etária
      const idades = []; let semData = 0;
      for (const p of pac) { const s = sens.get(p.id); if (s?.data_nascimento) idades.push(anos(s.data_nascimento)); else semData++; }
      const faixas = faixasDe(idades); if (semData) faixas.push(['Não informado', semData]);

      // comorbidades (um paciente conta em cada uma que tiver)
      const comFilt = com.filter((c) => ids.has(c.paciente_id));

      // visitas por prestador
      const porPrest = new Map();
      for (const v of vis) {
        const u = usuarios.get(v.prestador_id);
        const nome = u ? u.nome : 'Desconhecido';
        const r = porPrest.get(nome) || { area: u?.area || '—', c: 0, a: 0 };
        if (v.situacao === 'concluida') r.c++; else if (v.situacao === 'agendada') r.a++;
        porPrest.set(nome, r);
      }

      // último atendimento concluído por paciente
      const ultimo = new Map();
      for (const v of visitas) if (v.situacao === 'concluida') { const a = ultimo.get(v.paciente_id); if (!a || v.data_visita > a) ultimo.set(v.paciente_id, v.data_visita); }
      const N = cidade?.dias_sem_visita_alerta ?? 60;
      const semVisita = pac.filter((p) => p.status === 'ativo' && (!ultimo.get(p.id) || dias(ultimo.get(p.id), HOJE) >= N));

      const nomeP = new Map(pacientes.map((p) => [p.id, p.nome]));
      const proximas = visitas.filter((v) => v.situacao === 'agendada' && v.data_visita >= HOJE && ids.has(v.paciente_id))
        .sort((a, b) => a.data_visita.localeCompare(b.data_visita)).slice(0, 15);

      const grade = [
        sec('sexo', 'Pacientes por sexo', tabela(['Sexo', 'Total'], contar(pac, (p) => (p.sexo ? SEXO[p.sexo] : 'Não informado')))),
        sec('faixa', 'Faixa etária', tabela(['Faixa', 'Pacientes'], faixas)),
        sec('situacao', 'Pacientes por situação', tabela(['Situação', 'Total'], Object.entries(STATUS).map(([k, v]) => [v, cont(k)]))),
        sec('bairro', 'Pacientes por bairro', tabela(['Bairro', 'Total'], contar(pac, (p) => p.bairro || 'Não informado'))),
        sec('esf', 'Pacientes por ESF', tabela(['ESF', 'Total'], contar(pac, (p) => p.esf || 'Não informado'))),
        sec('comorbidade', 'Pacientes por comorbidade', tabela(['Comorbidade', 'Total'], contar(comFilt, (c) => c.comorbidades?.nome || 'Não informado'))),
        sec('prestador', 'Visitas por prestador (período)', tabela(['Prestador', 'Área', 'Concluídas', 'Agendadas'],
          [...porPrest.entries()].map(([n, r]) => [n, r.area, r.c, r.a]))),
        sec('semvisita', `Ativos sem visita há ${N} dias ou mais`, tabela(['Paciente', 'Último atendimento'],
          semVisita.map((p) => [p.nome, ultimo.get(p.id) ? fmt(ultimo.get(p.id)) : 'Nunca']))),
        sec('agenda', 'Próximas visitas agendadas', tabela(['Data', 'Paciente', 'Prestador'],
          proximas.map((v) => [fmt(v.data_visita), nomeP.get(v.paciente_id), usuarios.get(v.prestador_id)?.nome || '—']))),
      ];
      return cards + '<div class="grade">' + grade.join('') + '</div>';
    }

    // ---------- seções do prestador (só dados de pacientes designados e das próprias visitas) ----------
    function htmlPrestador(f, pac, vis) {
      const ids = new Set(pac.map((p) => p.id));
      const conc = vis.filter((v) => v.situacao === 'concluida');
      const agd = vis.filter((v) => v.situacao === 'agendada');
      const ultimoMeu = new Map();
      for (const v of visitas) if (v.situacao === 'concluida') { const a = ultimoMeu.get(v.paciente_id); if (!a || v.data_visita > a) ultimoMeu.set(v.paciente_id, v.data_visita); }
      const N = cidade?.dias_sem_visita_alerta ?? 60;

      const cards = `<div class="cards" data-secao="resumo" data-titulo="Resumo">` +
        kpi(pac.length, 'Pacientes designados') + kpi(pac.filter((p) => p.status === 'ativo').length, 'Ativos') +
        kpi(conc.length, 'Minhas visitas concluídas (período)') + kpi(agd.length, 'Minhas visitas agendadas (período)') + '</div>';

      const idades = []; let semData = 0;
      for (const p of pac) { const s = sens.get(p.id); if (s?.data_nascimento) idades.push(anos(s.data_nascimento)); else semData++; }
      const faixas = faixasDe(idades); if (semData) faixas.push(['Não informado', semData]);

      const meus = pac.map((p) => {
        const prox = agenda.filter((a) => a.paciente_id === p.id && a.situacao === 'agendada' && a.data_visita >= HOJE)
          .map((a) => a.data_visita).sort()[0];
        return [p.nome, STATUS[p.status] || p.status, fmt(p.data_inicio), ultimoMeu.get(p.id) ? fmt(ultimoMeu.get(p.id)) : '—', prox ? fmt(prox) : '—'];
      });

      const agendaFutura = agenda.filter((a) => a.data_visita >= HOJE && ids.has(a.paciente_id))
        .sort((a, b) => a.data_visita.localeCompare(b.data_visita));
      const nomeP = new Map(pac.map((p) => [p.id, p.nome]));

      const semVisita = pac.filter((p) => p.status === 'ativo' && (!ultimoMeu.get(p.id) || dias(ultimoMeu.get(p.id), HOJE) >= N));

      const grade = [
        sec('meus', 'Meus pacientes designados', tabela(['Paciente', 'Situação', 'Início', 'Minha última visita', 'Próxima visita'], meus)),
        sec('faixa', 'Faixa etária dos meus pacientes', tabela(['Faixa', 'Pacientes'], faixas)),
        sec('comorbidade', 'Comorbidades dos meus pacientes', tabela(['Comorbidade', 'Total'],
          contar(com.filter((c) => ids.has(c.paciente_id)), (c) => c.comorbidades?.nome || 'Não informado'))),
        sec('agenda', 'Agenda futura dos meus pacientes', tabela(['Data', 'Paciente', 'Quem atende', 'Situação'],
          agendaFutura.map((a) => [fmt(a.data_visita), nomeP.get(a.paciente_id), a.prestador_id === eu.id ? 'Você' : 'Outro profissional', a.situacao]))),
        sec('semvisita', `Meus ativos sem visita há ${N} dias ou mais`, tabela(['Paciente', 'Minha última visita'],
          semVisita.map((p) => [p.nome, ultimoMeu.get(p.id) ? fmt(ultimoMeu.get(p.id)) : 'Nunca']))),
      ];
      return cards + '<div class="grade">' + grade.join('') + '</div>';
    }

    // ---------- filtros, renderização e exportação ----------
    function render() {
      const f = {
        de: $('f-de').value, ate: $('f-ate').value, sit: $('f-sit').value,
        prest: eu.papel === 'master' ? ($('f-prest').value || null) : eu.id,
      };
      const base = eu.papel === 'master'
        ? new Set(pacientes.map((p) => p.id))
        : new Set(designacoes.filter((d) => d.usuario_id === eu.id).map((d) => d.paciente_id));
      const pac = pacientes.filter((p) => base.has(p.id) &&
        (f.sit === 'todas' || p.status === f.sit) &&
        (eu.papel !== 'master' || !f.prest || designacoes.some((d) => d.usuario_id === f.prest && d.paciente_id === p.id)));
      const idsPac = new Set(pac.map((p) => p.id));
      const vis = visitas.filter((v) => v.data_visita >= f.de && v.data_visita <= f.ate &&
        (eu.papel === 'master'
          ? idsPac.has(v.paciente_id) && (!f.prest || v.prestador_id === f.prest)
          : v.prestador_id === eu.id));

      $('conteudo').innerHTML = eu.papel === 'master' ? htmlMaster(f, pac, vis) : htmlPrestador(f, pac, vis);
      cabecalho(f);
      montarChecks();
    }

    function cabecalho(f) {
      const sit = f.sit === 'todas' ? 'Todas' : STATUS[f.sit];
      const pr = f.prest ? (usuarios.get(f.prest)?.nome || '—') : 'Todos';
      $('cabecalho-impressao').innerHTML =
        `<strong>Projeto Finito: relatório${cidade ? ' · ' + esc(cidade.nome) : ''}</strong><br>` +
        `Período: ${fmt(f.de)} a ${fmt(f.ate)} · Situação: ${esc(sit)} · Prestador: ${esc(pr)}<br>` +
        `Gerado em ${new Date().toLocaleString('pt-BR')} por ${esc(eu.nome)} (${PAPEL[eu.papel]})`;
    }

    function montarChecks() {
      $('checks').innerHTML = [...document.querySelectorAll('[data-secao]')].map((el) =>
        `<label style="display:inline-flex;gap:4px;margin-right:10px"><input type="checkbox" checked data-alvo="${el.dataset.secao}"> ${esc(el.dataset.titulo)}</label>`).join('');
    }

    function exportar() {
      document.querySelectorAll('#checks input').forEach((c) => {
        const el = document.querySelector(`[data-secao="${c.dataset.alvo}"]`);
        if (el) el.classList.toggle('oculto-impressao', !c.checked);
      });
      window.print();
    }

    // ---------- inicialização ----------
    (async () => {
      const { data: { session } } = await sb.auth.getSession();
      if (!session) { location.href = 'index.html'; return; }
      const { data: u } = await sb.from('usuarios').select('id,nome,papel,area,cidade_id').eq('auth_uid', session.user.id).maybeSingle();
      if (!u) { await sb.auth.signOut(); location.href = 'index.html'; return; }
      eu = u;
      $('nome').textContent = eu.nome;
      $('perfil').textContent = PAPEL[eu.papel] || eu.papel;

      const ini = new Date(); ini.setDate(ini.getDate() - 365);
      $('f-de').value = ini.toISOString().slice(0, 10);
      $('f-ate').value = HOJE;
      $('f-sit').innerHTML = '<option value="todas">Todas</option>' +
        Object.entries(STATUS).map(([k, v]) => `<option value="${k}">${v}</option>`).join('');

      await carregar();

      if (eu.papel === 'master') {
        $('lbl-prest').hidden = false;
        $('f-prest').innerHTML = '<option value="">Todos</option>' +
          [...usuarios.values()].filter((x) => x.papel === 'prestador')
            .map((x) => `<option value="${x.id}">${esc(x.nome)}</option>`).join('');
      }

      $('aplicar').onclick = render;
      $('pdf').onclick = exportar;
      $('sair').onclick = async () => { await sb.auth.signOut(); location.href = 'index.html'; };
      render();
    })();
  </script>
</body>
</html>
